# Copie para .env.local e preencha depois que o projeto Supabase existir
# (ver ../SETUP-INFRAESTRUTURA.md). Nunca commite .env.local — já está no
# .gitignore padrão do create-next-app.

# Supabase — client (públicas, RLS protege o acesso)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role, só usada server-side pelo cron de keepalive
# (/api/cron/keepalive). Bypassa RLS de propósito — nunca expor ao client.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo que só a Vercel e este projeto conhecem, pra confirmar que a
# chamada em /api/cron/keepalive veio do Cron da Vercel e não de qualquer
# um batendo na URL. Gere uma string aleatória qualquer.
CRON_SECRET=

# GitHub — credencial de escrita usada só em /api/promote (server-side).
# Token de acesso pessoal com escopo restrito ao repo `feel-cerebro`, ou
# credenciais de GitHub App — decisão em aberto, ver
# ../SETUP-INFRAESTRUTURA.md §5.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=feel-cerebro
GITHUB_BRANCH=main
